# Local services
POSTGRES_DB=freely
POSTGRES_USER=freely
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://freely:replace-with-a-random-password@postgres:5432/freely
INTERNAL_API_TOKEN=replace-with-a-random-token

# AI provider. Scout and deterministic filters work without this key.
OPENAI_API_KEY=
AI_FAST_MODEL=openai:gpt-5.4-nano
AI_QUALITY_MODEL=openai:gpt-5.4-mini
STRONG_LEAD_THRESHOLD=70
PIPELINE_PROCESS_LIMIT=5
FREELANCER_MIN_DESCRIPTION_CHARS=80

# Telegram command listener. Only TELEGRAM_CHAT_ID may issue /run freely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT=20

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-random-32-byte-or-longer-value
N8N_HOST=localhost
N8N_HOST_PORT=5679
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5679/

# Source settings
REMOTEOK_API_URL=https://remoteok.com/api
SCOUT_LIMIT=100
SCOUT_CONTRACT_ONLY=true

# Free, read-only opportunity sources
JOBICY_ENABLED=true
JOBICY_API_URL=https://jobicy.com/api/v2/remote-jobs
JOBICY_SCOUT_LIMIT=100
REMOTIVE_ENABLED=true
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
REMOTIVE_SCOUT_LIMIT=100
GITHUB_ISSUES_ENABLED=true
GITHUB_API_URL=https://api.github.com/search/issues
GITHUB_TOKEN=
GITHUB_ISSUE_QUERIES=is:issue is:open bounty automation || is:issue is:open bounty python || is:issue is:open "paid task" spreadsheet
GITHUB_SCOUT_LIMIT=25

# Freelancer.com official API. Keep false unless Freelancer has given express written permission.
FREELANCER_API_AUTHORIZED=false
FREELANCER_OAUTH_TOKEN=
FREELANCER_API_URL=https://www.freelancer.com/api/projects/0.1
FREELANCER_SEARCH_QUERY=n8n automation api integration openai python data entry excel google sheets web research virtual assistant web scraping chatbot lead generation wordpress
FREELANCER_SCOUT_LIMIT=50
