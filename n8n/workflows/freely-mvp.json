{
  "name": "FREELY MVP - Scout to Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "1",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-620, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/pipeline/run?concurrency=2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 600000
        }
      },
      "id": "2",
      "name": "Run FREELY pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "FREELY Internal API"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "processed",
        "options": {}
      },
      "id": "3",
      "name": "Split opportunities",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "deliver-ready",
              "leftValue": "={{ $json.deliver }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4",
      "name": "Proposal ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [100, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "telegram_chunks",
        "options": {
          "destinationFieldName": "message"
        }
      },
      "id": "5",
      "name": "Split Telegram messages",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [340, -80]
    },
    {
      "parameters": {
        "chatId": "CONFIGURE_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "id": "6",
      "name": "Send Telegram draft",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [580, -80],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_IN_N8N",
          "name": "FREELY Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [[{"node": "Run FREELY pipeline", "type": "main", "index": 0}]]
    },
    "Run FREELY pipeline": {
      "main": [[{"node": "Split opportunities", "type": "main", "index": 0}]]
    },
    "Split opportunities": {
      "main": [[{"node": "Proposal ready?", "type": "main", "index": 0}]]
    },
    "Proposal ready?": {
      "main": [
        [{"node": "Split Telegram messages", "type": "main", "index": 0}],
        []
      ]
    },
    "Split Telegram messages": {
      "main": [[{"node": "Send Telegram draft", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "timezone": "Asia/Manila"
  },
  "versionId": "d3d08d15-3a11-4c17-9c19-freely000001",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "id": "FREELY_MVP",
  "tags": []
}
